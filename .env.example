# RetailNova environment example.
# Note: this file currently documents only the settings below; it is not yet a
# complete template for a working .env.

# Optional secret for the public first-run setup form (/setup/superadmin).
# When set, the form must submit a matching setup token. Leave empty for local
# development. In production, first-run setup stays closed until this is set.
SETUP_TOKEN=

# Logging: one file per day in storage/logs, kept for 14 days.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
